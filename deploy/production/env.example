# Copy to .env (gen-secrets.sh does it and fills the secrets). Keep .env readable by root only.
APP_DOMAIN=pulse.example.com      # the app, API, SDK and tracking links
PAGES_DOMAIN=go.example.com       # landing pages, forms, surveys, archive (its own origin)

# Generated by gen-secrets.sh: never reuse the dev values from deploy/docker-compose.yml.
PULSE_SECRET_KEY=
PULSE_ADMIN_TOKEN=
PG_PASSWORD=
CH_PASSWORD=
REDIS_PASSWORD=

# Optional: a default SMTP relay for workspaces without their own email provider
# (e.g. email-smtp.ap-south-1.amazonaws.com:587). Workspaces can add providers in the app instead.
SMTP_ADDR=
SMTP_FROM=
# Optional: an Anthropic API key turns on AI help (only the text being worked on is sent).
PULSE_AI_API_KEY=
# Optional: off-server backups with rclone (e.g. "r2:pulse-backups"); configure rclone first.
BACKUP_REMOTE=
